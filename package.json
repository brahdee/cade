{
  "name": "cade",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.10.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.8"
  },
  "scripts": {
    "build": "svelte-kit sync && tsc -p tsconfig.bot.json",
    "start": "node dist/index.js",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:push": "drizzle-kit push",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "dev:bot": "tsx watch src/index.ts",
    "dev:web": "vite dev",
    "dev": "concurrently --kill-others --names bot,web --prefix-colors blue,green \"pnpm dev:bot\" \"pnpm dev:web\"",
    "build:web": "svelte-kit sync && vite build",
    "start:web": "node --env-file=.env build",
    "check:web": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.3.0",
    "lavalink-client": "^2.11.2",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
